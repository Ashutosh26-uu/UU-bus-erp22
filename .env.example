# ---- UU Bus ERP configuration (copy to .env) ----

# Port and bind address
PORT=3000
HOST=0.0.0.0

# Public URL that STUDENT PHONES can reach. This is what the QR code encodes.
# Leave empty to auto-detect your LAN IP (e.g. http://192.168.1.10:3000).
# For production use your https domain, e.g. https://bus.college.edu
BASE_URL=

# Set to "production" when deployed behind HTTPS
NODE_ENV=development

# If behind a reverse proxy (nginx, Cloudflare, Render...) set to 1 so real client IPs are used
TRUST_PROXY=

# Session secret (>=32 chars). If empty, a strong one is generated once and stored in data/secret.key
SESSION_SECRET=

# Security tuning
SESSION_HOURS=12          # staff login session length
QR_ROTATE_SECONDS=20      # QR refresh interval; a scanned QR is valid for at most 2x this
QR_GRACE_SLOTS=1          # how many previous QR windows are still accepted
CHECKIN_MINUTES=5         # time a student has to finish after scanning
MAX_DEVICES_PER_STUDENT=2 # phones a student may use in 30 days before admin reset is needed

# Force cookie Secure flag (auto true when BASE_URL is https)
COOKIE_SECURE=

# ---- Database ----
# Leave empty to use the local SQLite file data/bus-erp.sqlite.
# Set both to use Turso (required on Vercel; `npx vercel env pull .env` fills them in).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: password for the first "admin" account when the database has no users yet
ADMIN_PASSWORD=

# ---- Serverless (auto-detected on Vercel) ----
# SERVERLESS=1          force serverless behaviour locally (npm run serve:function)
# LIVE_MODE=poll        "sse" = instant push (single server), "poll" = DB-backed polling (serverless)
# RATE_LIMIT_STORE=db   "memory" (single server) or "db" (shared by all serverless instances)
